{
  "name": "peblish",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.19.0 <25"
    }
  },
  "scripts": {
    "gen": "node scripts/gen.ts && pnpm --filter @peblish/web gen:routes",
    "typecheck": "pnpm gen && pnpm -r typecheck && tsc -p tsconfig.json",
    "lint": "pnpm gen && pnpm lint:boundaries && oxlint --deny-warnings",
    "lint:boundaries": "depcruise packages --config .dependency-cruiser.cjs",
    "test": "pnpm gen && vitest run",
    "build": "pnpm gen && pnpm -r build",
    "check": "pnpm build && pnpm typecheck && pnpm lint && pnpm test",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "db:migrate": "pnpm --filter @peblish/core db:migrate",
    "db:generate": "pnpm --filter @peblish/core db:generate",
    "db:drift": "pnpm --filter @peblish/core db:drift",
    "lane": "sh scripts/lane.sh"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.58.2",
    "@types/node": "24.19.2",
    "dependency-cruiser": "18.7.2",
    "oxlint": "1.92.0",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
