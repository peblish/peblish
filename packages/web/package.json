    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@react-aria/optimize-locales-plugin": "2.1.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.2.1",
    "nitro": "3.0.261103-rc",
    "vite": "8.3.6"
