    "@hono/node-server": "2.1.6",
    "@logtape/file": "2.4.2",
    "@logtape/logtape": "2.4.2",
    "hono": "4.13.17",
    "marked": "18.1.3",
    "postgres": "3.4.9",
    "temporal-polyfill": "1.0.8"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "5.9.3"
  }
}
