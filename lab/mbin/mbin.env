# Mbin 1.11 lab instance (lab-only secrets, never reuse). Real environment wins over the
# image's compiled .env (composer dump-env prod), so everything the lab changes is here.
APP_ENV=prod
APP_SECRET=feddit-lab-mbin-app-secret-0123456789abcdef
MBIN_USER=1000:1000
PHP_LOG_LEVEL=error

# Behind lab Caddy on plain HTTP; TRUSTED_PROXIES must name the lab /24, which is not a private
# range, or Symfony builds http:// URLs for federation (the lab front door terminates TLS).
SERVER_NAME=:80
TRUSTED_PROXIES=44.255.99.0/24
KBIN_DOMAIN=mbin.lab.test
KBIN_TITLE=Mbin lab
KBIN_DEFAULT_LANG=en
KBIN_FEDERATION_ENABLED=true
KBIN_CONTACT_EMAIL=contact@mbin.lab.test
KBIN_SENDER_EMAIL=noreply@mbin.lab.test
KBIN_JS_ENABLED=true
KBIN_REGISTRATIONS_ENABLED=true
KBIN_STORAGE_URL=https://mbin.lab.test/media
KBIN_CAPTCHA_ENABLED=false
# Federates with the lab hosts only; the list itself is seeded by lab/mbin/seed.sh.
MBIN_USE_FEDERATION_ALLOW_LIST=true
MBIN_DOWNVOTES_MODE=enabled
KBIN_ADMIN_ONLY_OAUTH_CLIENTS=false
MBIN_NEW_USERS_NEED_APPROVAL=false
CORS_ALLOW_ORIGIN=*

POSTGRES_DB=mbin
POSTGRES_USER=mbin
POSTGRES_PASSWORD=mbin
POSTGRES_VERSION=17
DATABASE_URL=postgresql://mbin:mbin@mbin-db:5432/mbin?serverVersion=17&charset=utf8

REDIS_PASSWORD=mbin
REDIS_DNS=redis://mbin@mbin-valkey:6379

RABBITMQ_DEFAULT_USER=mbin
RABBITMQ_DEFAULT_PASS=mbin
MESSENGER_TRANSPORT_DSN=amqp://mbin:mbin@mbin-rabbitmq:5672/%2f/messages

# No mail, no S3, no captcha.
MAILER_DSN=null://null
S3_KEY=
LOCK_DSN=flock

# No Mercure hub runs (lab/mbin/Caddyfile has none); live-update publishes go nowhere.
MERCURE_URL=http://127.0.0.1:1/.well-known/mercure
MERCURE_PUBLIC_URL=https://mbin.lab.test/.well-known/mercure
MERCURE_JWT_SECRET=feddit-lab-mbin-mercure-secret-0123456789

# OAuth2 server keys, generated at first start by lab/mbin/entrypoint.sh.
OAUTH_PRIVATE_KEY=%kernel.project_dir%/config/oauth2/private.pem
OAUTH_PUBLIC_KEY=%kernel.project_dir%/config/oauth2/public.pem
OAUTH_PASSPHRASE=feddit-lab-mbin-oauth-pass
OAUTH_ENCRYPTION_KEY=feddit-lab-mbin-oauth-encryption-key-0123456789
