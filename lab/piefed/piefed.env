# PieFed 1.8.11 lab instance (lab-only secrets, never reuse).
SECRET_KEY=feddit-lab-piefed-secret-key-0123456789abcdef
SERVER_NAME=piefed.lab.test
HTTP_PROTOCOL=https

POSTGRES_USER=piefed
POSTGRES_PASSWORD=piefed
POSTGRES_DB=piefed
DATABASE_URL=postgresql+psycopg2://piefed:piefed@piefed-db/piefed

CACHE_TYPE=RedisCache
CACHE_REDIS_URL=redis://piefed-redis:6379/0
CELERY_BROKER_URL=redis://piefed-redis:6379/1
RESULT_BACKEND=redis://piefed-redis:6379/1

FULL_AP_CONTEXT=0
ENABLE_ALPHA_API=true
SERVE_API_DOCS=true
CORS_ALLOW_ORIGIN=*

# Scenarios drive the API from one container IP; do not throttle them.
RATELIMIT_ENABLED=false
VOTE_QUOTA=100000

# The host convenience port is plain HTTP.
SESSION_COOKIE_SECURE=0

# Record every incoming activity (with JSON, since site.log_activitypub_json
# is set by bootstrap.py) in activity_pub_log; `make captures` dumps it.
LOG_ACTIVITYPUB_TO_DB=1

CELERY_CONCURRENCY=2
GUNICORN_WORKERS=2
CRON=false
