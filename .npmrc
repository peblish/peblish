engine-strict=true
# Mux UI 0.1.0-rc.5 exposes no locale provider. React Aria Components is only a transitive
# dependency of @muxui/react; hoisting it exposes that single copy (no second copy, no second
# context) so packages/ui can import RAC's I18nProvider. Remove once the Mux rc exports one.
public-hoist-pattern[]=react-aria-components
